soong_namespace {
    imports: [
        "vendor/nvidia/common/rel-shield-r/nvphs",
    ],
}

cc_prebuilt_library_shared {
    name: "vendor.nvidia.hardware.phs@1.0-impl",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "vendor.nvidia.hardware.phs@1.0-impl_32-defaults",
        "vendor.nvidia.hardware.phs@1.0-impl_64-defaults",
    ],
    compile_multilib: "both",
    soc_specific: true,
    vintf_fragments: ["nvphsd.xml"],
}

cc_prebuilt_library_shared {
    name: "libnvphs",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "libnvphs_32-defaults",
        "libnvphs_64-defaults",
    ],
    compile_multilib: "both",
    soc_specific: true,
    required: [
        "libnvgov_boot",
        "libnvgov_camera",
        "libnvgov_force",
        "libnvgov_generic",
        "libnvgov_gpucompute",
        "libnvgov_graphics",
        "libnvgov_il",
        "libnvgov_spincircle",
        "libnvgov_tbc",
        "libnvgov_ui",
    ],
}

