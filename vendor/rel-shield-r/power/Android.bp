cc_prebuilt_binary {
    name: "vendor.nvidia.hardware.power@1.0-service",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "vendor.nvidia.hardware.power@1.0-service_32-defaults",
        "vendor.nvidia.hardware.power@1.0-service_64-defaults",
    ],
    compile_multilib: "first",
    relative_install_path: "hw",
    soc_specific: true,
    init_rc: ["etc/init/vendor.nvidia.hardware.power@1.0-service.rc"],
    required: ["powerhal.tegra"],
}

cc_prebuilt_library_shared {
    name: "powerhal.tegra",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "powerhal.tegra_32-defaults",
        "powerhal.tegra_64-defaults",
    ],
    compile_multilib: "both",
    relative_install_path: "hw",
    soc_specific: true,
}
