cc_prebuilt_library_shared {
    name: "libnvmmlite_video",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: select(soong_config_variable("target_tegra", "dolby"), {
        any @ flag_val: ["libnvmmlite_video.dolby_32-defaults", "libnvmmlite_video.dolby_64-defaults"],
        default: ["libnvmmlite_video_32-defaults", "libnvmmlite_video_64-defaults"],
    }),
    compile_multilib: "both",
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libnvomx",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: select(soong_config_variable("target_tegra", "dolby"), {
        any @ flag_val: ["libnvomx.dolby_32-defaults", "libnvomx.dolby_64-defaults"],
        default: ["libnvomx_32-defaults", "libnvomx_64-defaults"],
    }),
    compile_multilib: "both",
    soc_specific: true,
    target: {
        android_arm: {
            required: [
                "libnvmm_audio",
                "libnvmm_msaudio",
                "libnvmm_parser",
                "libnvmm_writer",
                "libnvmmlite_audio",
                "libnvmmlite_image",
                "libnvmmlite_msaudio",
                "libnvmmlite_video",
            ],
        },
        android_arm64: {
            required: [
                "libnvmm_parser",
                "libnvmmlite_image",
                "libnvmmlite_video",
            ],
        },
    },
}

cc_prebuilt_library_shared {
