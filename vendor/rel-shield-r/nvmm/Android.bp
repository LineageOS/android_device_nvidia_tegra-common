soong_namespace {
    imports: [
        "vendor/nvidia/common/rel-shield-r/nvmm",
    ],
}

cc_prebuilt_library_shared {
    name: "libnvavp",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "libnvavp_32-defaults",
        "libnvavp_64-defaults",
    ],
    compile_multilib: "both",
    soc_specific: true,
}

