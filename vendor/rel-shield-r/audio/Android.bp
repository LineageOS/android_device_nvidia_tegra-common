android_app_import {
    name: "NvAudioSvc",
    owner: "nvidia",
    apk: ":NvAudioSvc-srcs",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "DolbyAudioService",
    owner: "nvidia",
    apk: ":DolbyAudioService-srcs",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    soc_specific: true,
}

cc_prebuilt_binary {
    name: "android.hardware.audio@6.0-service-msd",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "android.hardware.audio@6.0-service-msd_32-defaults",
    ],
    compile_multilib: "32",
    relative_install_path: "hw",
    soc_specific: true,
    init_rc: ["etc/init/android.hardware.audio@6.0-service-msd.rc"],
    vintf_fragments: ["android.hardware.audio.service.msd.xml"],
    required: [
        "cp_pgm_one_dap_lib",
        "cp_pgm_two_dap_lib",
        "cp_sys_one_dap_lib",
        "cp_sys_two_dap_lib",
        "ddp_enc_lib_ac3",
        "ddp_enc_lib_eac3",
        "ddp_udc_lib_ac3",
        "ddp_udc_lib_ec3",
        "dp_dap_lib",
    ],
}

cc_prebuilt_library_shared {
    name: "audio.primary.tegra",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "audio.primary.tegra_32-defaults"
    ],
    compile_multilib: "32",
    relative_install_path: "hw",
    soc_specific: true,
    required: [
        "libnvvisualizer",
    ],
}

cc_prebuilt_library_shared {
    name: "sound_trigger.primary.tegra",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "sound_trigger.primary.tegra_32-defaults",
    ],
    compile_multilib: "32",
    relative_install_path: "hw",
    soc_specific: true,
    vintf_fragments: select(soong_config_variable("TARGET_TEGRA", "ST23"), {
        any @ flag_val: ["android.hardware.soundtrigger.23.xml"],
        default: ["android.hardware.soundtrigger.xml"],
    }),
}

