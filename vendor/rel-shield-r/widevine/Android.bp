    name: "libwvhidl",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "libwvhidl_32-defaults",
    ],
    compile_multilib: "32",
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "liboemcrypto",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "liboemcrypto_32-defaults",
    ],
    compile_multilib: "32",
    soc_specific: true,
