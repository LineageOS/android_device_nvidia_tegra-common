cc_prebuilt_binary {
    name: "android.hardware.drm@1.3-service.widevine",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "android.hardware.drm@1.3-service.widevine_32-defaults",
    ],
    compile_multilib: "32",
    relative_install_path: "hw",
    soc_specific: true,
    init_rc: ["etc/init/android.hardware.drm@1.3-service.widevine.rc"],
    vintf_fragments: ["widevine.xml"],
}

