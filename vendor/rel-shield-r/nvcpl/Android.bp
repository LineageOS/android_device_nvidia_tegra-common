android_app_import {
    name: "NvCPLSvc",
    owner: "nvidia",
    apk: ":NvCPLSvc-srcs",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    required: [
        "libnvcontrol_jni",
    ],
}

cc_prebuilt_binary {
    name: "vendor.nvidia.hardware.cpl.service@1.0-service",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "vendor.nvidia.hardware.cpl.service@1.0-service_32-defaults",
        "vendor.nvidia.hardware.cpl.service@1.0-service_64-defaults",
    ],
    compile_multilib: "first",
    relative_install_path: "hw",
    soc_specific: true,
    init_rc: ["etc/init/vendor.nvidia.hardware.cpl.service@1.0-service.rc"],
    vintf_fragments: ["vendor.nvidia.hardware.cpl.service@1.0-service.xml"],
}

cc_prebuilt_binary {
    name: "vendor.nvidia.hardware.cpl.service_common@1.0-service",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "vendor.nvidia.hardware.cpl.service_common@1.0-service_32-defaults",
        "vendor.nvidia.hardware.cpl.service_common@1.0-service_64-defaults",
    ],
    compile_multilib: "first",
    relative_install_path: "hw",
    soc_specific: true,
    init_rc: ["etc/init/vendor.nvidia.hardware.cpl.service_common@1.0-service.rc"],
    vintf_fragments: ["vendor.nvidia.hardware.cpl.service_common@1.0-service.xml"],
}

cc_prebuilt_library_shared {
    name: "libnvcpl_vendor",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "libnvcpl_vendor_32-defaults",
        "libnvcpl_vendor_64-defaults",
    ],
    compile_multilib: "both",
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libnvcontrol_jni",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "libnvcontrol_jni_32-defaults",
        "libnvcontrol_jni_64-defaults",
    ],
    compile_multilib: "both",
    soc_specific: true,
}
