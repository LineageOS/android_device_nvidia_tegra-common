soong_namespace {
    imports: [
        "vendor/nvidia/common/rel-shield-r/common",
    ],
}

cc_prebuilt_library_shared {
    name: "libnvos",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "libnvos_32-defaults",
        "libnvos_64-defaults",
    ],
    compile_multilib: "both",
    soc_specific: true,
}

prebuilt_etc {
    name: "public.libraries",
    src: "public.libraries.txt",
    filename: "public.libraries.txt",
    soc_specific: true,
}
