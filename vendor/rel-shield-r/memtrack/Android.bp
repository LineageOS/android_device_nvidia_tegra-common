soong_namespace {
    imports: [
        "vendor/nvidia/common/rel-shield-r/memtrack",
    ],
}

cc_prebuilt_library_shared {
    name: "memtrack.tegra",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "memtrack.tegra_32-defaults",
        "memtrack.tegra_64-defaults",
    ],
    compile_multilib: "both",
    relative_install_path: "hw",
    soc_specific: true,
    vintf_fragments: ["android.hardware.memtrack@1.0-service-nvidia.xml"],
}
