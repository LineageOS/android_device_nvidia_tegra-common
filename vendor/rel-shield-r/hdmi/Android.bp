soong_namespace {
    imports: [
        "vendor/nvidia/common/rel-shield-r/hdmi",
    ],
}

cc_defaults {
    name: "rel-shield-r-hdmi-enabled",
    enabled: select(soong_config_variable("target_tegra", "hdmi"), {
        any @ flag_val: true,
        default: false,
    }),
},

cc_prebuilt_library_shared {
    name: "hdmi_cec.tegra",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "rel-shield-r-hdmi-enabled",
        "hdmi_cec.tegra_32-defaults",
        "hdmi_cec.tegra_64-defaults",
    ],
    compile_multilib: "both",
    relative_install_path: "hw",
    soc_specific: true,
}
