soong_namespace {
    imports: [
        "vendor/nvidia/common/r35/l4t",
    ],
}

cc_prebuilt_library_shared {
    name: "ld-linux-aarch64.so.1",
    suffix: "",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "ld-linux-aarch64.so.1_64-defaults",
    ],
    compile_multilib: "64",
    relative_install_path: "l4t",
    soc_specific: true,
}

